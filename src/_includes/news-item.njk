---
layout: base.njk
---
<article class="wrap narrow page">
  <p class="eyebrow">{{ page.date | readableDate }}{% if kind %} · {{ kind }}{% endif %}</p>
  <h1>{{ title }}</h1>
  {% if video %}<div class="video"><iframe src="{{ video }}" title="{{ title }}" allowfullscreen loading="lazy"></iframe></div>{% endif %}
  <div class="prose">{{ content | safe }}</div>
  {% if link %}<p><a class="button" href="{{ link }}">{{ link_label or "Read more" }}</a></p>{% endif %}
</article>
