---
layout: base.njk
---
<article class="wrap narrow page">
  <h1>{{ title }}</h1>
  {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
  {% if image %}<figure class="page-photo"><img src="{{ image }}" alt="{{ image_alt }}" loading="lazy">{% if image_caption %}<figcaption>{{ image_caption }}</figcaption>{% endif %}</figure>{% endif %}
  <div class="prose">{{ content | safe }}</div>
</article>
